# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sketch2code

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email (used for verification / forgot-password links, Phase 1 = console logger) ---
EMAIL_SENDER=noreply@sketch2code.ai
EMAIL_BACKEND=console
# set to smtp and fill these in for real sending later
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- AI vision provider (Feature 1: handwritten label OCR) ---
# "gemini" or "openai" — only the matching key below needs to be set.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Admin bootstrap ---
# Comma-separated emails that automatically get admin access on signup/login.
ADMIN_EMAILS=
